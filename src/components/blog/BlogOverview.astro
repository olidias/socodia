---
import PostCard from '~/components/blog/PostCard.astro';
import { useTranslations } from '~/i18n/utils';
import { getBlogPosts } from '~/utils/blogPosts';
import type { BlogLang } from '~/utils/blogPosts';

export interface Props {
  lang: BlogLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getBlogPosts(lang);
---

<!-- Hero Section -->
<section
  class="relative bg-gradient-to-b from-blue-50 dark:from-slate-800 to-white dark:to-slate-900 pt-20 pb-16 overflow-hidden"
>
  <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05]"></div>
  <div class="relative mx-auto px-4 sm:px-6 max-w-5xl text-center">
    <p class="mb-3 font-semibold text-primaryLight dark:text-blue-200 text-base uppercase tracking-wide">
      {t('blog.eyebrow')}
    </p>
    <h1
      class="mb-6 font-heading font-bold text-gray-900 dark:text-white text-4xl md:text-5xl lg:text-6xl leading-tight tracking-tighter"
    >
      {t('blog.title')}
    </h1>
    <p class="mx-auto max-w-3xl text-muted dark:text-slate-400 text-lg leading-relaxed">{t('blog.intro')}</p>
  </div>
</section>

<!-- Post Cards -->
<section class="mx-auto px-4 sm:px-6 pb-20 max-w-5xl">
  {
    posts.length > 0 ? (
      <div class="items-start gap-6 grid md:grid-cols-2">
        {posts.map((post) => (
          <PostCard post={post} readMoreLabel={t('shared.readmore')} />
        ))}
      </div>
    ) : (
      <p class="text-muted dark:text-slate-400 text-center">{t('blog.empty')}</p>
    )
  }
</section>
